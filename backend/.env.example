# SafeTrip AI - Backend Environment Configuration
# Supports PostgreSQL, MySQL, or SQLite out of the box:
# Example PostgreSQL: DATABASE_URL=postgresql://postgres:password@localhost:5432/safetrip_ai
# Example MySQL:      DATABASE_URL=mysql+pymysql://root:password@localhost:3306/safetrip_ai
DATABASE_URL=sqlite:///../data/safetrip_ai.db
JWT_SECRET_KEY=safetrip-ai-mca-capstone-secret-key-2026-secure
JWT_EXPIRE_MINUTES=10080
OPEN_METEO_ENABLED=true
OSRM_ROUTING_ENABLED=true
